+/**
+ * Thrown when boot finds `runs/server.pid` naming a live process: the pool
+ * already has a server, and there is no override that makes starting another
+ * acceptable. The message names the live pid, its port when the fleet
+ * registry knows it, and the pool directory.
+ */
+export class PoolLockedError extends Error {
+  readonly pid: number;
+  readonly port: number | null;
+  readonly poolDir: string;
+
+  constructor(pid: number, port: number | null, poolDir: string) {
+    const where = port !== null ? ` on port ${port}` : "";
+    super(
+      `pool ${poolDir} is already served by live process ${pid}${where}; ` +
+        "use the running console or kill it",
+    );
+    this.name = "PoolLockedError";
+    this.pid = pid;
+    this.port = port;
+    this.poolDir = poolDir;
+  }
+}
+
+const DEFAULT_REGISTRY_PATH = join(homedir(), ".agent-graphs", "pools.json");
+const PID_FILE_NAME = "server.pid";
+
+// A signal-0 probe: the process answers if it exists and we may signal it, and
+// EPERM still means it exists behind a permission boundary. ESRCH and any
+// other failure mean it is gone.
+function isProcessAlive(pid: number): boolean {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (err) {
+    return (err as NodeJS.ErrnoException).code === "EPERM";
+  }
+}
+
+// Best-effort lookup of the port a live server holds, for the refusal message.
+// The fleet registry may not exist (a pool with no live entry, or a registry
+// not yet written): a missing, corrupt, or non-matching file answers null and
+// the refusal still names the pid and pool dir.
+function registryPort(
+  poolDir: string,
+  pid: number,
+  registryPath: string,
+): number | null {
+  let entries: unknown;
+  try {
+    entries = JSON.parse(readFileSync(registryPath, "utf8"));
+  } catch {
+    return null;
+  }
+  if (!Array.isArray(entries)) return null;
+  for (const entry of entries) {
+    if (
+      entry !== null &&
+      typeof entry === "object" &&
+      (entry as { poolDir?: unknown }).poolDir === poolDir &&
+      (entry as { pid?: unknown }).pid === pid
+    ) {
+      const port = (entry as { port?: unknown }).port;
+      return typeof port === "number" ? port : null;
+    }
+  }
+  return null;
+}
+
+// One server per pool, enforced here in the factory: read runs/server.pid, and
+// if it names a live process refuse to boot; otherwise write our own pid. A
+// stale file or a garbage one is taken over silently, and a first boot writes
+// with no prior file at all. There is deliberately no --force path.
+function acquirePoolLock(poolDir: string, registryPath: string): void {
+  const runsDir = join(poolDir, "runs");
+  mkdirSync(runsDir, { recursive: true });
+  const pidFile = join(runsDir, PID_FILE_NAME);
+  let existing = "";
+  try {
+    existing = readFileSync(pidFile, "utf8").trim();
+  } catch {
+    // absent: a first boot
+  }
+  if (existing !== "") {
+    const pid = Number(existing);
+    if (Number.isInteger(pid) && pid > 0 && isProcessAlive(pid)) {
+      throw new PoolLockedError(
+        pid,
+        registryPort(poolDir, pid, registryPath),
+        poolDir,
+      );
+    }
+  }
+  writeFileSync(pidFile, `${process.pid}\n`);
 }
 
