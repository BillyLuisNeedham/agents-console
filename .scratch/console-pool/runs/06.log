  expect(approved.final.tickets).toEqual({ "01": "done", "02": "done", "03": "done" });
  expect(git(["rev-parse", "--verify", "pool/02"]).exitCode).not.toBe(0);
  expect(existsSync(join(poolDir, ".git", "pool-worktrees", "02"))).toBe(false);
}, 15000);
