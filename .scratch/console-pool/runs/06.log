### Spawning the resolver in the drive loop

Now the flow. Let me write `handleMergeConflict`:

```ts
async function handleMergeConflict(session, marker, result): Promise<void> {
  const worktree: WorktreeInfo = {
    path: worktreePathFor(session.cwd, marker.id),
    branch: branchFor(marker.id),
  };
  const resolver = resolveResolver(session, marker); // { harness, model, prompt ... } or null
  if (!resolver) {
    raiseInterrupt(session, manualMergeInterrupt(session, marker, result, "no resolver configured (console.json resolver= unset and no ~/.issue-runner default)"));
    return;
  }
  const attempt = await runResolver(session, marker, worktree, resolver);
  if (attempt.resolved) {
    raiseInterrupt(session, approvalInterrupt(session, marker, result, attempt.note));
  } else {
    raiseInterrupt(session, manualMergeInterrupt(session, marker, result, attempt.note));
  }
}
```

