export function buildResolverPrompt(p: ResolverPromptParts): string {
  return [
    `Resolve the git merge conflict for ticket ${p.id}.`,
    "",
    `You are in the git worktree at ${p.worktree}, with branch ${p.branch} checked out. The pool's working branch is ${p.workingBranch}.`,
    "",
    `To reproduce the conflict, run: git merge ${p.workingBranch}`,
    `Then resolve each conflicted file (${p.files.join(", ") || "see git status"}), stage the resolution with git add, and DO NOT commit.`,
    "",
    `When you have staged a resolution, write JSON to ${p.outcomePath}:`,
    `{"resolved": true, "note": "what you did, in a sentence or two"}`,
    "",
    `If you cannot resolve it, write {"resolved": false, "note": "why"} and exit.`,
  ].join("\n");
}
```

