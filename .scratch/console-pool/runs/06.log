```ts
interface ResolverSpec { harness: string; model: string; }
function resolveResolver(session): ResolverSpec | null {
  const config = session.state.config;
  let harness = config.resolver;
  let model = config.defaults?.model;
  if (!harness || !model) {
    const ir = readIssueRunner();
    if (!harness) harness = ir?.harness;
    if (!model) model = ir?.model;
  }
  if (!harness || !model) return null;
  if (!session.harnesses[harness]) return null;
  return { harness, model };
}

function readIssueRunner(): { harness?: string; model?: string } | null {
  const file = join(os.homedir(), ".issue-runner");
  if (!existsSync(file)) return null;
  const fields = new Map<string, string>();
  for (const line of readFileSync(file, "utf8").split("\n")) {
    const eq = line.indexOf("=");
    if (eq > 0) fields.set(line.slice(0, eq).trim(), line.slice(eq + 1).trim());
  }
  return {
    harness: fields.get("harness"),
    model: fields.get("model"),
  };
}
```

