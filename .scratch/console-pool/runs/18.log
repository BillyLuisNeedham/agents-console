+/**
+ * Read a byte range of a log file: from `offset` up to `LOG_CHUNK_BYTES` more
+ * bytes (or EOF), ANSI-stripped. The client pages by requesting from the
+ * returned `nextOffset` until it equals `totalSize`.
+ */
+function readLogRange(
+  logPath: string,
+  offset: number,
+): { content: string; offset: number; nextOffset: number; totalSize: number } {
+  let raw: Uint8Array;
+  let totalSize: number;
+  try {
+    const file = Bun.file(logPath);
+    totalSize = file.size;
+  } catch {
+    return { content: "", offset: 0, nextOffset: 0, totalSize: 0 };
+  }
+  const start = Math.min(Math.max(0, offset), totalSize);
+  const end = Math.min(start + LOG_CHUNK_BYTES, totalSize);
+  try {
+    raw = new Uint8Array(Bun.file(logPath).slice(start, end));
+  } catch {
+    return { content: "", offset: start, nextOffset: end, totalSize };
+  }
+  return {
+    content: stripAnsi(new TextDecoder().decode(raw)),
+    offset: start,
+    nextOffset: end,
+    totalSize,
+  };
