Server logic:
```ts
let current: PoolRun | null = null;
let latest: PoolSnapshot | null = null;
const clients = new Set<SSEClient>();

function emit(snapshot) {
  latest = snapshot;
  for (const c of clients) c.send(snapshot);
}

async function start(poolDir, harnesses) {
  // close previous run
  current?.close();
  current = await runPool({ poolDir, onSnapshot: emit });
  return latest;
}

async function answer(ticketId, note, action) {
  const run = current;
  if (!run) throw ...
  const next = action === 'approve' ? await run.approve(ticketId, note)
    : action === 'reject' ? await run.reject(ticketId, note)
    : await run.resume(ticketId, note);
  current = next;
  return latest;
}
```

