      "#!/usr/bin/env bash", "set -uo pipefail",
      'issue="$1"; status="$2"; outcome_path="$3"; outcome_json="$4"; exit_code="$5"; plan="$6"',
      'WORK_FILE=""; WORK_LINE=""; OVERWRITE=""; COMMIT_MSG=""; WAIT_MERGED=""; MAIN_REPO=""',
      'source "$plan"',
      'if [ -n "$WAIT_MERGED" ]; then for _ in $(seq 1 100); do git -C "$MAIN_REPO" log --format=%s 2>/dev/null | grep -q "$WAIT_MERGED" && break; sleep 0.05; done; git -C "$MAIN_REPO" log --format=%s | grep -q "$WAIT_MERGED" || exit 42; fi',
      'staged=0',
      'if [ -n "$WORK_FILE" ]; then mkdir -p "$(dirname "$WORK_FILE")"; if [ -n "$OVERWRITE" ]; then printf \'%s\\n\' "${WORK_LINE:-work}" > "$WORK_FILE"; else printf \'%s\\n\' "${WORK_LINE:-work}" >> "$WORK_FILE"; fi; git add "$WORK_FILE"; staged=1; fi',
      'sed -i "1s/status=[a-z-]*/status=$status/" "$issue"',
      'git add "$issue"; staged=1',
      'if [ "$staged" = "1" ]; then git commit -qm "${COMMIT_MSG:-ticket}"; fi',
      'exit "$exit_code"',
      "",
    ].join("\n"));
    chmodSync(stubPath, 0o755);
    const behaviours: Record<string, any[]> = {
      "01": [{ workFile: "shared.txt", workLine: "from-01", overwrite: true, commitMsg: "work-01" }],
      "02": [
        { waitMerged: "work-01", workFile: "shared.txt", workLine: "from-02", overwrite: true, commitMsg: "work-02" },
        { workFile: "shared.txt", workLine: "from-02", overwrite: true, commitMsg: "work-02-again" },
      ],
      "03": [{ workFile: "three.txt", commitMsg: "work-03" }],
      "04": [{ workFile: "four.txt", commitMsg: "work-04" }],
    };
    const counts: Record<string, number> = {};
    const stub: HarnessCommand = (ctx) => {
      const n = counts[ctx.id] ?? 0; counts[ctx.id] = n + 1;
      const b = behaviours[ctx.id][Math.min(n, behaviours[ctx.id].length - 1)];
      const plan = join(poolDir, `plan-${ctx.id}-${n}.sh`);
      const lines = [`MAIN_REPO=${JSON.stringify(poolDir)}`];
      if (b.workFile) lines.push(`WORK_FILE=${JSON.stringify(b.workFile)}`);
      if (b.workLine) lines.push(`WORK_LINE=${JSON.stringify(b.workLine)}`);
      if (b.overwrite) lines.push('OVERWRITE="1"');
      if (b.commitMsg) lines.push(`COMMIT_MSG=${JSON.stringify(b.commitMsg)}`);
      if (b.waitMerged) lines.push(`WAIT_MERGED=${JSON.stringify(b.waitMerged)}`);
