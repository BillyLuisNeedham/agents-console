    const approved = await run.approve("02");
    console.log("after approve phase:", approved.phase, "interrupts:", approved.interrupts.map((i) => `${i.ticketId}:${i.kind}`));
    const rejected = await run.reject("review", "redo 02 04");
    console.log("after reject phase:", rejected.phase, "interrupts:", rejected.interrupts.map((i) => `${i.ticketId}:${i.kind}`));
    console.log("tickets:", JSON.stringify(rejected.final.tickets));
  });
});
