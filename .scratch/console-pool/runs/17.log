+export function lastAttemptOfKind(
+  runsDir: string,
+  ticketId: string,
+  kind: TicketEventKind,
+): number {
+  return readEvents(runsDir, ticketId).reduce(
+    (max, event) => (event.kind === kind ? Math.max(max, event.attempt) : max),
+    0,
+  );
