      'source "$plan"', ': "${CONFLICT_FILE:=}" "${RESOLUTION:=}"',
      'git -C "$worktree" merge main >/dev/null 2>&1 || true',
      'printf \'%s\\n\' "$RESOLUTION" > "$worktree/$CONFLICT_FILE"',
      'git -C "$worktree" add "$CONFLICT_FILE"',
      'printf \'{"resolved": true, "note": "ok"}\' > "$outcome"',
      "exit 0", "",
    ].join("\n"));
    chmodSync(resPath, 0o755);
    const resStub: HarnessCommand = (ctx) => {
      const plan = join(poolDir, `res-plan-${ctx.id}.sh`);
      writeFileSync(plan, "RESOLVED=1\nCONFLICT_FILE=shared.txt\nRESOLUTION=resolved-by-agent\n");
      return ["bash", resPath, ctx.outcomePath, plan, ctx.cwd];
    };

    const run = await runPool({ poolDir, harnesses: { stub, "resolver-stub": resStub } });
