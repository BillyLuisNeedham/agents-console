+      { cwd: repoDir, stdout: "pipe", stderr: "pipe" },
+    );
+    // Only the loser exits; the winner holds the lock and keeps running.
+    const loser = await Promise.race([
+      first.exited.then(() => first),
+      second.exited.then(() => second),
+    ]);
+    const winner = loser === first ? second : first;
+    const exitCode = await loser.exited;
+    const stderr = await new Response(loser.stderr).text();
+    expect(exitCode).not.toBe(0);
+    expect(stderr).toContain("locked by live server pid");
