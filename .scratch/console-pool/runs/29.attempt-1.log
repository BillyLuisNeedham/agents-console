+describe("fleet registry concurrency", () => {
+  /** A child that upserts one distinct entry, given registry, poolDir, port. */
+  function spawnUpserter(
+    repoDir: string,
+    fleetTs: string,
+    registry: string,
+    poolDir: string,
+    port: number,
+  ): ReturnType<typeof Bun.spawn> {
+    const code = [
+      `import { upsertFleetEntry } from "${fleetTs}";`,
+      `const [registry, poolDir, port] = Bun.argv.slice(1);`,
+      `upsertFleetEntry(registry, { poolDir, port: Number(port), pid: process.pid, startedAt: "t" });`,
+    ].join("\n");
+    return Bun.spawn(
+      ["bun", "-e", code, registry, poolDir, String(port)],
+      { cwd: repoDir, stdout: "pipe", stderr: "pipe" },
+    );
+  }
+
+  it("concurrent upserts from different processes all land, losing none", async () => {
+    const dir = tempDir();
+    const registry = join(dir, "pools.json");
+    const repoDir = join(import.meta.dir, "..");
+    const fleetTs = join(import.meta.dir, "fleet.ts");
+    const count = 8;
+    const children: ReturnType<typeof Bun.spawn>[] = [];
+    for (let i = 0; i < count; i++) {
+      const poolDir = join(dir, `pool-${i}`);
+      mkdirSync(poolDir, { recursive: true });
+      children.push(spawnUpserter(repoDir, fleetTs, registry, poolDir, 8000 + i));
+    }
+    for (const child of children) {
+      expect(await child.exited).toBe(0);
+    }
+    const entries = readFleetEntries(registry);
+    expect(entries).toHaveLength(count);
+    for (let i = 0; i < count; i++) {
+      const poolDir = join(dir, `pool-${i}`);
+      expect(entries.some((entry) => entry.poolDir === poolDir)).toBe(true);
+    }
+  });
+
+  it("writes atomically: a reader never sees a partial registry while a writer works", async () => {
+    const dir = tempDir();
+    const registry = join(dir, "pools.json");
+    const repoDir = join(import.meta.dir, "..");
+    const fleetTs = join(import.meta.dir, "fleet.ts");
