+    expect(match).not.toBeNull();
+    const winnerPid = Number(match![1]);
+    expect(pidIsLive(winnerPid)).toBe(true);
+    // The winner's claim survived the loser's failed boot.
+    expect(readFileSync(join(poolDir, "runs", "server.pid"), "utf8").trim()).toBe(
