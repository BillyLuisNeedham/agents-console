{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "typeRoots": ["../../../node_modules/@types"],
    "types": ["bun"],
    "paths": {
      "@console/*": ["../../../ui/src/*"],
      "@engine/*": ["../../../engine/*"],
      "@protocol": ["../../../ui/src/protocol.ts"],
      "@bench/page": ["./bench.ts"],
      "@bench/frame": ["../../../ui/src/frame.ts"]
    }
  },
  // bench-sse.ts is typed against the seams of the checkouts from before
  // issue #161, which this tree's ui/src no longer has; it is only ever
  // built against such a checkout.
  "include": ["./bench.ts", "./page.ts", "./fixture.ts", "./probe.ts", "./unbatched.ts", "./env.d.ts"]
}
