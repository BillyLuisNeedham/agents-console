{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": ["engine", "scripts", "conformance"],
  // The lag bench's page is a browser module, checked by its own tsconfig.
  "exclude": ["scripts/bench-lag/ui"]
}